# PR-PIET-FORK: standalone from-source Dockerfile for the GitHub Action.
#
# Upstream folded the github_action image into docker/Dockerfile (commit
# e8077630, "fold github_action Dockerfile ... into existing definitions")
# and now publishes it via `docker build --target github_action docker/Dockerfile`.
# GitHub Actions docker actions cannot pass `--target`, so this fork keeps a
# standalone Dockerfile that mirrors the upstream `base` + `github_action`
# stages verbatim. action.yaml references this file so fork patches (see
# PR-PIET-PATCH.md) are built INTO the container instead of running the
# prebuilt upstream image from Docker Hub.
#
# KEEP IN SYNC with docker/Dockerfile (upstream): re-copy the `base` stage and
# the `github_action` stage whenever upstream changes them.

FROM python:3.14.7-slim AS base
COPY --from=ghcr.io/astral-sh/uv:0.12.10 /uv /uvx /bin/

# litellm fetches its model cost map over the network at import time, so a
# third-party change to that map can change runtime behavior with no image
# change and no version bump. Use the map bundled with the litellm pinned in
# uv.lock so every stage (test and runtime) behaves how it was built and tested
# rather than tracking today's remote data; new models then arrive with a
# deliberate litellm bump in the lockfile.
ENV LITELLM_LOCAL_MODEL_COST_MAP=True

RUN apt-get update && apt-get install --no-install-recommends -y git curl && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV UV_COMPILE_BYTECODE=1
COPY pyproject.toml uv.lock ./
COPY docs docs
RUN uv sync --frozen --no-install-project --no-dev
ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONPATH=/app

FROM base AS github_action
COPY pr_agent pr_agent
COPY github_action/entrypoint.sh /
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
